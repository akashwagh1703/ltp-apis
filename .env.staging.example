APP_NAME="Let's Turf Play"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://staging-api.playltp.in

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ltp_db_staging
DB_USERNAME=ltp_user
DB_PASSWORD=

SANCTUM_TOKEN_EXPIRATION=43200

CORS_ALLOWED_ORIGINS=https://staging.playltp.in,https://admin-staging.playltp.in,https://playltp.in,https://www.playltp.in,https://admin.playltp.in,http://localhost:5173,http://127.0.0.1:5173

SENTRY_LARAVEL_DSN=

BACKUP_KEEP_DAYS=14
BACKUP_RESTORE_DRILL_DB=ltp_restore_drill
BACKUP_RESTORE_ADMIN_DB=postgres

FILESYSTEM_MEDIA_DISK=public
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ltp-media
MINIO_PRIVATE_BUCKET=ltp-private

FIREBASE_CREDENTIALS=storage/firebase-credentials.json
